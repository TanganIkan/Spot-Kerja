# Untuk script di folder tool/ (import data awal). JANGAN dipakai di app.
# Salin jadi .env lalu isi:  cp .env.example .env
# File .env diabaikan Git, jadi tidak akan ikut ter-commit.

SUPABASE_URL=https://ISI-PROJECT-REF.supabase.co

# Secret key (sb_secret_...) dari Supabase -> Project Settings -> API Keys.
# Kunci admin: jangan dibagikan, jangan ditempel di chat.
SUPABASE_SERVICE_ROLE_KEY=ISI-SECRET-KEY

# Nama penulis yang tampil di review data awal (opsional).
SEED_AUTHOR_NAME=Tim SpotKerja
